    "pieces": "node scripts/build-pieces.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "deckwright": "github:strodanodev/deckwright",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.186.1",
    "three.quarks": "0.17.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
