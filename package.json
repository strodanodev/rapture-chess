{
  "name": "rapture-chess",
  "version": "0.1.0",
  "private": true,
  "description": "Rapture Chess: a 3D Web3 chess game built with Deckwright, three.js and the Rapture ARC 1 collection on LitVM Liteforge.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "pieces": "node scripts/build-pieces.mjs",
    "lint": "tsc --noEmit",
    "relay": "tsx relay/server.mts",
    "test:contracts": "hardhat test",
    "test:relay": "node --test test/relay.test.mjs",
    "test:wager": "node --test test/wager-canonical.test.mjs",
    "test:mates": "node --test test/mates.test.mjs",
    "test": "pnpm test:contracts && pnpm test:wager && pnpm test:mates && pnpm test:relay",
    "title": "node scripts/build-title.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@noble/hashes": "1.8.0",
    "chess.js": "1.4.0",
    "tessaract": "github:strodanodev/tessaract#v0.9.2",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.186.1",
    "three.quarks": "0.17.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@openzeppelin/contracts": "5.0.2",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.1",
    "ethers": "6.17.0",
    "hardhat": "2.29.1",
    "tsx": "4.23.7",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "ws": "8.18.3"
  }
}
