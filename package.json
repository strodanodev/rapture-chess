{
  "name": "rapture-chess",
  "version": "0.1.0",
  "private": true,
  "description": "Rapture Chess: a 3D Web3 chess game built with Deckwright, three.js and the Rapture ARC 1 collection on LitVM Liteforge.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174",
    "build": "vite build",
